// Job enqueued in the Jobqueue. Wrapper for the list head.
#[pin_data]
struct EnqueuedJob {
    #[pin]
    links: ListLinks,
    inner: Job,
    done_fence: DmaFence,
    // When a job is created, it's not known whether it can be pushed yet. Since
    // the hardware fence comes from the driver's run_job() callback, it can only
    // be initializced later.
    hardware_fence: Option<DmaFence>,
}

impl EnqueuedJob {
    fn new(job: Job, fctx: &DmaFenceCtx) -> Result<ListArc<Self>> {
        ListArc::pin_init(try_pin_init!(Self {
            links <- ListLinks::new(),
            inner: job,
            done_fence <- fctx.as_arc_borrow().new_fence()?,
        }), GFP_KERNEL)
    }
}

