    /// Submit a [`Job`] to the Jobqueue. This is fire and forget since you pass the job by value.
    ///
    /// All dependencies the job shall wait for and all callbacks that shall be executed once the job
    /// is completed can only be set before submitting the job.
    ///
    /// Jobs cost credits. The jobqueue's capacity is defined on creation as a u32
    /// and each running job subtracts its u32 credit cost from that capacity.
    /// The data type therefore ensures that the largest pushable job cannot
    /// be larger than the jobqueue's total capacity, at most.
    pub fn submit_job(&mut self, job_inner: Job) -> Result<DmaFence> {
        let job = EnqueuedJob::new(job_inner, &self.inner.fctx)?;
        let done_fence = job.done_fence.clone(); // Get the fence for the user.

        // TODO register job's callbacks on done_fence.

        // Check if there are dependencies and, if yes, register rewake
        // callbacks on their fences.
        job.arm_deps();

        let jobq = self.inner.lock();

        if jobq.has_waiting_jobs() {
            // Jobs waiting means that there is currently no capacity for more
            // jobs. The hardware fences' callbacks will pull in more jobs once
            // there's capacity.
            jobq.waiting_jobs.push_back(job);
            // TODO what about registering the dependency handlers?
            return Ok(done_fence);
        }

        if jobq.has_capacity_left(job.inner.credits) {
            if job.all_deps_fullfilled() {
                jobq.run_job(job)?; // TODO in case of error kill jobqueue?
            }
        }

        // If there was no capacity for the job, the callbacks registered on the
        // already running jobs' hardware fences will check if there's space for
        // the next job, guaranteeing progress.
        //
        // If no jobs were running, there was by definition still space and the
        // job got pushed.
        //
        // If a job couldn't be pushed because there were unfinished dependencies,
        // then the hardware fences' callbacks mentioned above will detect that
        // and not yet push the job.
        //
        // Each dependency's fence has its own callback which checks:
        //   a) whether all other callbacks are fullfilled and if yes:
        //   b) whether there is now enough credits available.
        //
        // If a) and b) are fullfilled, the job gets pushed.
        //
        // If there are no jobs currently running, credits must be available by
        // definition.

        Ok(done_fence)
    }
